<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>2.0.0</Version>
    <Title>SqlLinq</Title>
    <Authors>dkackman, lennykean</Authors>
    <Description>A dynamic Sql query library that supports plain text queries in Linq-to-Objects scenarios. Sql syntax is the majority of ANSI Sql 89 SELECT syntax.</Description>
    <Copyright>Copyright Don Kackman 2026</Copyright>
    <PackageTags>Linq;Dynamic;Sql;Query</PackageTags>
    <PackageLicenseFile>License.md</PackageLicenseFile>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LinqStatistics" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\deps\GoldParser\GoldParser.csproj" PrivateAssets="all" />
    <None Include="$(OutDir)GoldParser.dll" Pack="true" PackagePath="lib\$(TargetFramework)" />
    <None Include="..\License.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="SQL-ANSI-89.4.cgt" />
  </ItemGroup>
</Project>